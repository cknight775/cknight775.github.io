---
interface Props {
  showProjects?: boolean;
  showCredentials?: boolean;
}

const { showProjects = false, showCredentials = false } = Astro.props;
const links = [
  { href: '/#perfil', label: 'Perfil' },
  { href: '/#experiencia', label: 'Experiencia' },
  ...(showProjects ? [{ href: '/#proyectos', label: 'Proyectos' }] : []),
  ...(showCredentials
    ? [{ href: '/#credenciales', label: 'Credenciales' }]
    : []),
  { href: '/#contacto', label: 'Contacto' },
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Ir al inicio">
    <span>CC</span>
    <small>Ciberseguridad · Producto</small>
  </a>
  <button
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="primary-navigation"
  >
    <span>Menú</span>
  </button>
  <nav id="primary-navigation" aria-label="Navegación principal">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const button = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const navigation = header?.querySelector<HTMLElement>('#primary-navigation');
  const mobile = window.matchMedia('(max-width: 620px)');

  function setMenu(open: boolean, returnFocus = false) {
    if (!button || !navigation) return;
    const mobileOpen = mobile.matches && open;
    button.setAttribute('aria-expanded', String(mobileOpen));
    navigation.toggleAttribute('data-open', mobileOpen);
    navigation.inert = mobile.matches && !mobileOpen;
    if (returnFocus) button.focus();
  }

  button?.addEventListener('click', () => {
    setMenu(button.getAttribute('aria-expanded') !== 'true');
  });

  navigation?.addEventListener('click', (event) => {
    if (event.target instanceof HTMLAnchorElement && mobile.matches) {
      setMenu(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (
      event.key === 'Escape' &&
      button?.getAttribute('aria-expanded') === 'true'
    ) {
      setMenu(false, true);
    }
  });

  mobile.addEventListener('change', () => setMenu(false));
  setMenu(false);
</script>
