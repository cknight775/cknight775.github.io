---
import Header from '@/components/Header.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { profile, specialties, technologies } from '@/data/profile';
import { projects } from '@/data/projects';
---

<BaseLayout>
  <div class="page-shell">
    <Header />
    <main id="contenido">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">{profile.eyebrow}</p>
          <h1 id="hero-title">
            Seguridad que se<br />
            <span>entiende y funciona.</span>
          </h1>
          <p class="hero-positioning">{profile.positioning}</p>
          <div class="actions">
            <a class="button primary" href="#proyectos">Explorar proyectos</a>
            <a class="button secondary" href={profile.links.linkedin}
              >Ver LinkedIn</a
            >
          </div>
        </div>
        <aside class="hero-card" aria-label="Resumen profesional">
          <div class="signal">
            <span></span>
            {profile.status}
          </div>
          <p class="mono">// perfil profesional</p>
          <h2>{profile.shortName}</h2>
          <p>{profile.summary}</p>
          <dl>
            <div><dt>Base</dt><dd>{profile.location}</dd></div>
            <div><dt>Foco</dt><dd>Blue Team + Producto</dd></div>
            <div><dt>Experiencia</dt><dd>Entornos críticos</dd></div>
          </dl>
        </aside>
      </section>

      <section class="metrics" aria-label="Indicadores verificables">
        {
          profile.metrics.map((metric) => (
            <div>
              <>
                <strong>{metric.value}</strong>
                <span>{metric.label}</span>
              </>
            </div>
          ))
        }
      </section>

      <section id="perfil" class="section-block">
        <div class="section-heading">
          <p class="eyebrow">Perfil</p>
          <h2>Cuatro capacidades.<br />Una mirada integral.</h2>
          <p>
            La seguridad no termina en una alerta: también necesita personas
            preparadas y herramientas que permitan actuar.
          </p>
        </div>
        <div class="specialty-grid">
          {
            specialties.map((item) => (
              <article class="specialty-card">
                <span class="card-number">{item.number}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <ul>
                  {item.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section id="experiencia" class="section-block experience">
        <div class="section-heading">
          <p class="eyebrow">Trayectoria</p>
          <h2>Experiencia construida desde la operación.</h2>
          <p>
            Desde 2021, las responsabilidades de concientización se desarrollan
            de manera concurrente con las funciones de análisis y respuesta a
            incidentes iniciadas en 2019.
          </p>
        </div>
        <div class="timeline">
          <article>
            <time>2021 — Actualidad</time>
            <div>
              <h3>Jefe de Concientización en Ciberseguridad</h3><p>
                Dirección de un equipo de cinco personas, campañas y formación
                para audiencias institucionales.
              </p>
            </div>
          </article>
          <article>
            <time>2019 — Actualidad</time>
            <div>
              <h3>Analista de Amenazas y Respuesta a Incidentes</h3><p>
                Monitoreo, correlación y respuesta en operaciones SOC dentro de
                un entorno crítico.
              </p>
            </div>
          </article>
          <article>
            <time>2020 — 2021</time>
            <div>
              <h3>Administrador de Sitios Web</h3><p>
                Administración de servidores, portales educativos y
                mantenimiento de soluciones web.
              </p>
            </div>
          </article>
        </div>
      </section>

      <section id="proyectos" class="section-block projects">
        <div class="section-heading horizontal">
          <div>
            <p class="eyebrow">Casos de estudio</p><h2>
              De la necesidad<br />a la solución.
            </h2>
          </div>
          <p>
            Casos públicos y sanitizados que explican responsabilidades y
            decisiones sin exponer información operacional.
          </p>
        </div>
        <div class="project-list">
          {
            projects.map((project, index) => (
              <a class="project-card" href={`/proyectos/${project.slug}/`}>
                <span class="project-index">0{index + 1}</span>
                <div>
                  <>
                    <p>{project.eyebrow}</p>
                    <h3>{project.title}</h3>
                    <span>{project.summary}</span>
                  </>
                </div>
                <strong aria-hidden="true">↗</strong>
              </a>
            ))
          }
        </div>
      </section>

      <section class="section-block stack">
        <div class="section-heading">
          <p class="eyebrow">Herramientas</p><h2>Tecnología con propósito.</h2>
        </div>
        <div class="stack-grid">
          {
            technologies.map((group) => (
              <article>
                <>
                  <h3>{group.title}</h3>
                  <ul>
                    {group.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </>
              </article>
            ))
          }
        </div>
      </section>

      <section id="contacto" class="contact">
        <p class="eyebrow">Contacto</p>
        <h2>Conversemos sobre el próximo desafío.</h2>
        <p>
          Para oportunidades profesionales, proyectos o colaboraciones
          tecnológicas.
        </p>
        <a class="button light" href={`mailto:${profile.email}`}
          >Escribir por correo</a
        >
        <div class="social-links">
          <a href={profile.links.linkedin}>LinkedIn</a>
          <a href={profile.links.github}>GitHub</a>
          <a href={profile.links.credly}>Credly</a>
        </div>
      </section>
    </main>
    <footer>
      <span>© {new Date().getFullYear()} {profile.name}</span><span
        >Construido con Astro · Sin analítica</span
      >
    </footer>
  </div>
</BaseLayout>

