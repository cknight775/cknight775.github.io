---
import Header from '@/components/Header.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projects } from '@/data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<BaseLayout
  title={`${project.title} | Cristóbal Catalán`}
  description={project.summary}
>
  <div class="page-shell">
    <Header />
    <main id="contenido" class="case-study">
      <a class="back-link" href="/#proyectos">← Volver a proyectos</a>
      <header class="case-hero">
        <p class="eyebrow">{project.eyebrow}</p>
        <h1>{project.title}</h1>
        <p>{project.summary}</p>
      </header>
      <div class="case-grid">
        <section>
          <p class="eyebrow">Contexto</p><h2>El desafío</h2><p>
            {project.context}
          </p>
        </section>
        <section>
          <p class="eyebrow">Responsabilidad</p><h2>Mi rol</h2><p>
            {project.role}
          </p>
        </section>
        <section class="wide">
          <p class="eyebrow">Enfoque</p><h2>Decisiones principales</h2><ul>
            {project.approach.map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section class="wide">
          <p class="eyebrow">Tecnologías publicables</p><div class="tag-row">
            {project.technologies.map((item) => <span>{item}</span>)}
          </div>
        </section>
      </div>
      {
        project.notice && (
          <aside class="security-note">
            <>
              <strong>Nota de alcance y seguridad</strong>
              <p>{project.notice}</p>
            </>
          </aside>
        )
      }
    </main>
    <footer>
      <span>© {new Date().getFullYear()} Cristóbal Catalán Guerrero</span><a
        href="/#contacto">Contacto</a>
    </footer>
  </div>
</BaseLayout>

