{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "astro.config.mjs", "src/**/*"],
  "exclude": [
    "assets/**",
    "dist/**",
    "forms/**",
    "index.html",
    "node_modules/**"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
